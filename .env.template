# =========================================================================
# CMMS 개발 환경변수 템플릿
# =========================================================================
# WSL 개발 PC에서는 이 파일을 `.env`로 복사해 사용합니다.
# 운영 서버는 같은 키 구조를 사용하되 별도의 강한 비밀번호와 운영값을 입력합니다.

# 애플리케이션
NODE_ENV=development
PORT=8080
CORS_ORIGINS=*

# GHCR 이미지
IMAGE_REGISTRY=ghcr.io/jamsildongsoo
IMAGE_TAG=latest

# Docker 호스트 데이터 루트
CMMS_DATA_ROOT=/var/lib/cmms-dev

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cmms
DB_USERNAME=cmms
# `#`가 포함되므로 반드시 따옴표를 유지합니다.
DB_PASSWORD='cmms123!@#A'
DB_SCHEMA=public
DB_SSL=false
DB_SYNCHRONIZE=true

# JWT 및 로그인 보안
JWT_SECRET=
# 미설정 또는 잘못된 값이면 기본값 1800초(30분)를 사용합니다.
JWT_EXPIRATION=1800
# 미설정 또는 빈 값이면 JWT_SECRET을 Refresh Secret으로 사용합니다.
JWT_REFRESH_SECRET=
# 미설정 또는 잘못된 값이면 기본값 259200초(3일)를 사용합니다.
JWT_REFRESH_EXPIRATION=259200
# 미설정 시 기본값 cmms_refresh를 사용합니다.
JWT_REFRESH_COOKIE_NAME=cmms_refresh
# 미설정 시 개발환경 false, 운영환경 true를 사용합니다.
JWT_REFRESH_COOKIE_SECURE=false
# 미설정 시 기본값 strict를 사용합니다.
JWT_REFRESH_COOKIE_SAMESITE=strict
# 미설정 시 기본값 /api/auth를 사용합니다.
JWT_REFRESH_COOKIE_PATH=/api/auth
PASSWORD_MAX_FAILED=5
PASSWORD_LOCK_MINUTES=30
# 미설정 시 기본값 90일을 사용합니다.
PASSWORD_EXPIRY_DAYS=90
# 신규 사용자 생성·삭제 사용자 복구 시 사용할 임시 비밀번호(8자 이상)
INITIAL_USER_PASSWORD=init1234

# 개발 MinIO Object Storage
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY=cmms-dev
STORAGE_SECRET_KEY='cmms-minio-dev-1234'
STORAGE_BUCKET=cmms-dev-files

# 파일 업로드 제한
FILE_MAX_SIZE_MB=10
FILE_MAX_COUNT=10
STORAGE_ALLOWED_MIMES=image/*,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-powerpoint,application/x-hwp,application/vnd.hancom.hwp,application/haansofthwp,application/hwp+zip,application/vnd.hancom.hwpx,application/octet-stream,application/zip,application/x-zip-compressed

# 미참조 Object Storage 객체 정리 작업
STORAGE_RECONCILE_ENABLED=false
STORAGE_RECONCILE_GRACE_HOURS=24
STORAGE_RECONCILE_CRON=0 0 4 * * *

# 전력거래소(KPX) CIM 계량 연동
# 운영 비밀번호와 공개키 파일은 저장소에 커밋하지 않습니다.
KPX_USER_ID=
KPX_PASSWORD=
KPX_ORG_CODE=8687
KPX_GENERATOR_ID=DC37
KPX_PUBKEY_PATH=/run/secrets/kpx-public-key
KPX_METER_ENDPOINT=http://services.kmos.kr/meter
